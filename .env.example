# SparkAgent environment template.
# Copy to .env (or set as real OS environment variables) and fill in.
# NEVER commit real values. SparkAgent reads credentials ONLY from the
# environment / encrypted vault — never from config files or source code.

# Remote LLM tier (GLM, OpenAI-compatible endpoint)
GLM_API_KEY=

# Telegram gateway (optional)
TELEGRAM_BOT_TOKEN=

# Master key for the local encrypted secret vault (optional; any long random string)
SPARKAGENT_VAULT_KEY=

# Optional: protect the web dashboard API (blank = localhost-only, no token)
SPARKAGENT_WEB_TOKEN=
